# Data Generator Environment Variables

# Kafka Configuration
KAFKA_BROKERS=localhost:9092
KAFKA_CLIENT_ID=pulse-data-generator

# Generator Configuration
EVENTS_PER_SECOND=100
ENABLE_ANOMALIES=true

# Traffic Patterns
BASE_TRAFFIC_MIN=100
BASE_TRAFFIC_MAX=500

# Anomaly Configuration
SPIKE_MULTIPLIER=10
ERROR_RATE_SPIKE_PERCENT=20
LATENCY_DEGRADATION_FACTOR=3

# Logging
LOG_LEVEL=info
